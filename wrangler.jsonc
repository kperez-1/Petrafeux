{
  "name": "petrafi-inspiration-demo-x7k2p9q4",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petrafi-db",
      "database_id": "08a46330-f1da-42f1-92be-f5662c4a4c86"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_CRM_REMOTE": "true"
  }
}
