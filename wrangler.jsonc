{
  "name": "petrafi-inspiration",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "petrafi-db",
      // Replace with your database_id after running: npx wrangler d1 create petrafi-db
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_CRM_REMOTE": "true"
  }
}
